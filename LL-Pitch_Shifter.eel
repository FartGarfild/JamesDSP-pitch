// ================================================
// Low Latency Pitch Shifter
// ================================================

slider1:0.0<-12.0,12.0,0.1>Semitones (Pitch)
slider2:60<40,160,5>Window Size (ms)
slider3:-120<-120,0,0.5>Dry Mix (dB)
quality:16<8,32,4>Buffer Quality

lookahead:22<0,50,5>Lookahead (ms)

@init
slider1 = -4;
slider2 = 60;
slider3 = -100;
quality = 16;
smooth = 0.00025;

lookahead = 22;

buf_size = srate * quality;
buf_L = 0;
buf_R = buf_size + 2;
memset(buf_L, 0, buf_size * 2 + 40);

write_pos = 0;
play_pos = 0;
scl_smooth = 1.0;

// ================================================

@sample
target_scl = 2 ^ (slider1 / 12);
scl_smooth = scl_smooth + (target_scl - scl_smooth) * smooth;
scl = scl_smooth;

drymix = 2 ^ (slider3 / 6);
step = scl - 1;

buf_L[write_pos] = spl0;
buf_R[write_pos] = spl1;

win_size = (srate * slider2 / 1000) | 0;
win_size = (win_size < 30) ? 30 : win_size;

offset = win_size;
lookahead_samples = (srate * lookahead / 1000) | 0;

p1 = play_pos % win_size;
p2 = (play_pos + win_size * 0.5) % win_size;

r1 = (write_pos - offset + lookahead_samples + p1 * step);
r2 = (write_pos - offset + lookahead_samples + p2 * step);

r1 = (r1 % buf_size); r1 < 0 ? r1 += buf_size;
r2 = (r2 % buf_size); r2 < 0 ? r2 += buf_size;

safety_margin = 70;
r1 = (abs(r1 - write_pos) < safety_margin) ? (write_pos - safety_margin) % buf_size : r1;
r2 = (abs(r2 - write_pos) < safety_margin) ? (write_pos - safety_margin) % buf_size : r2;

w1 = sin(p1 / win_size * $pi);
w2 = sin(p2 / win_size * $pi);

total_w = sqrt(w1*w1 + w2*w2) + 0.000001;
w1 /= total_w;
w2 /= total_w;

out0 = buf_L[r1|0] * w1 + buf_L[r2|0] * w2;
out1 = buf_R[r1|0] * w1 + buf_R[r2|0] * w2;

spl0 = out0 + spl0 * drymix;
spl1 = out1 + spl1 * drymix;

play_pos += 1;
play_pos >= win_size ? play_pos = 0;

write_pos += 1;
write_pos >= buf_size ? write_pos = 0;
